{
  "name": "Probability visualizer",
  "build": {
    "dockerfile": "../probability-endurance_streamlit/Dockerfile",
    "context": "../probability-endurance_streamlit"
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "probability-endurance_streamlit/main.py"
      ]
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "postAttachCommand": {
    "server": "streamlit run probability-endurance_streamlit/main.py --server.address=0.0.0.0"
  },
  "portsAttributes": {
    "8501": {
      "label": "Probability visualizer",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}
